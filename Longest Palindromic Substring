#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// Helper function to expand around a center index and find palindrome boundaries
int expandAroundCenter(char* s, int left, int right, int len) {
    while (left >= 0 && right < len && s[left] == s[right]) {
        left--;
        right++;
    }
    // Returns the length of the valid palindrome found
    return right - left - 1;
}

char* longestPalindrome(char* s) {
    if (s == NULL || strlen(s) < 1) {
        char* empty = (char*)malloc(1 * sizeof(char));
        empty[0] = '\0';
        return empty;
    }

    int len = strlen(s);
    int start = 0, end = 0;

    for (int i = 0; i < len; i++) {
        // Case 1: Odd-length palindromes (e.g., "aba", center is 'b')
        int len1 = expandAroundCenter(s, i, i, len);
        
        // Case 2: Even-length palindromes (e.g., "abba", center is between 'b' and 'b')
        int len2 = expandAroundCenter(s, i, i + 1, len);
        
        // Find the maximum length between both choices
        int maxLen = (len1 > len2) ? len1 : len2;

        // If a longer palindrome is found, update our boundaries
        if (maxLen > (end - start + 1)) {
            start = i - (maxLen - 1) / 2;
            end = i + maxLen / 2;
        }
    }

    // Allocate memory for the resulting substring (length + null-terminator)
    int resultLen = end - start + 1;
    char* result = (char*)malloc((resultLen + 1) * sizeof(char));
    
    // Copy the substring into the result array
    strncpy(result, s + start, resultLen);
    result[resultLen] = '\0'; // Add the null terminator string ending

    return result;
}
