#include <stdlib.h>

// Helper comparison function required by standard library qsort
int compareInts(const void* a, const void* b) {
    return (*(int*)a - *(int*)b);
}

// Main function to find the closest 3-integer sum to the target
int threeSumClosest(int* nums, int numsSize, int target) {
    // 1. Sort the array to enable systematic two-pointer adjustments
    qsort(nums, numsSize, sizeof(int), compareInts);
    
    // Initialize the closest sum with the first possible combination
    int closest_sum = nums[0] + nums[1] + nums[2];

    // 2. Loop through the array, fixing the first element of the triplet
    for (int i = 0; i < numsSize - 2; i++) {
        int left = i + 1;
        int right = numsSize - 1;

        while (left < right) {
            int current_sum = nums[i] + nums[left] + nums[right];

            // If an exact match is found, return immediately
            if (current_sum == target) {
                return current_sum;
            }

            // Update closest_sum if current_sum cuts closer to the target
            if (abs(current_sum - target) < abs(closest_sum - target)) {
                closest_sum = current_sum;
            }

            // 3. Move pointers strategically based on the sorted values
            if (current_sum < target) {
                left++;  // Increase sum by moving the left pointer up
            } else {
                right--; // Decrease sum by moving the right pointer down
            }
        }
    }

    return closest_sum;
}
