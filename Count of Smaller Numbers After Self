#include <stdlib.h>

// Structure to pair each value with its original index
typedef struct {
    int val;
    int index;
} Element;

// Merge function that counts smaller elements on the right
void merge(Element* arr, int left, int mid, int right, int* counts, Element* temp) {
    int i = left;       // Pointer for left subarray
    int j = mid + 1;    // Pointer for right subarray
    int k = left;       // Pointer for temp array
    int right_count = 0; // Tracks elements from right side that are smaller

    while (i <= mid && j <= right) {
        if (arr[j].val < arr[i].val) {
            // Right element is smaller -> increment jump counter
            right_count++;
            temp[k++] = arr[j++];
        } else {
            // Left element is smaller or equal -> add accumulated right jumps
            counts[arr[i].index] += right_count;
            temp[k++] = arr[i++];
        }
    }

    // Copy remaining elements of left subarray
    while (i <= mid) {
        counts[arr[i].index] += right_count;
        temp[k++] = arr[i++];
    }

    // Copy remaining elements of right subarray
    while (j <= right) {
        temp[k++] = arr[j++];
    }

    // Copy back to original array
    for (i = left; i <= right; i++) {
        arr[i] = temp[i];
    }
}

// Divide and conquer framework
void mergeSort(Element* arr, int left, int right, int* counts, Element* temp) {
    if (left >= right) return;
    
    int mid = left + (right - left) / 2;
    mergeSort(arr, left, mid, counts, temp);
    mergeSort(arr, mid + 1, right, counts, temp);
    merge(arr, left, mid, right, counts, temp);
}

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* countSmaller(int* nums, int numsSize, int* returnSize) {
    *returnSize = numsSize;
    int* counts = (int*)calloc(numsSize, sizeof(int));
    if (numsSize == 0) return counts;

    // Allocate temporary arrays for merge sort tracking
    Element* arr = (Element*)malloc(numsSize * sizeof(Element));
    Element* temp = (Element*)malloc(numsSize * sizeof(Element));

    // Initialize elements with values and original indexes
    for (int i = 0; i < numsSize; i++) {
        arr[i].val = nums[i];
        arr[i].index = i;
    }

    // Run modified merge sort
    mergeSort(arr, 0, numsSize - 1, counts, temp);

    // Free memory allocations
    free(arr);
    free(temp);

    return counts;
}
