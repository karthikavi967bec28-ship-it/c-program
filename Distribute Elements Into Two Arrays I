#include <stdlib.h>

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* resultArray(int* nums, int numsSize, int* returnSize) {
    // 1. Set the size of the output array to match the input size
    *returnSize = numsSize;
    
    // 2. Allocate memory for the final output array
    int* result = (int*)malloc(numsSize * sizeof(int));
    
    // 3. Use temporary fixed arrays to separate elements
    // Since arr1 and arr2 cannot exceed numsSize, allocating numsSize is perfectly safe
    int* arr1 = (int*)malloc(numsSize * sizeof(int));
    int* arr2 = (int*)malloc(numsSize * sizeof(int));
    
    int size1 = 0, size2 = 0;
    
    // 4. Distribute the first two elements according to rules
    arr1[size1++] = nums[0];
    arr2[size2++] = nums[1];
    
    // 5. Process the rest of the array elements
    for (int i = 2; i < numsSize; i++) {
        // Compare the last element currently in arr1 and arr2
        if (arr1[size1 - 1] > arr2[size2 - 1]) {
            arr1[size1++] = nums[i];
        } else {
            arr2[size2++] = nums[i];
        }
    }
    
    // 6. Concatenate arr1 and arr2 back into the result array
    int index = 0;
    for (int i = 0; i < size1; i++) {
        result[index++] = arr1[i];
    }
    for (int i = 0; i < size2; i++) {
        result[index++] = arr2[i];
    }
    
    // 7. Free dynamic memory allocations that are no longer needed
    free(arr1);
    free(arr2);
    
    return result;
}
