#include <math.h>

// Helper function to return the minimum of two values
int min(int a, int b) {
    return (a < b) ? a : b;
}

int minCostClimbingStairs(int* cost, int costSize) {
    // Variables to store the minimum cost to reach the last two steps
    // We can start at either index 0 or index 1 with 0 initial cost
    int prev2 = 0; // Cost to reach 2 steps behind
    int prev1 = 0; // Cost to reach 1 step behind
    int current = 0;
    
    // Iteratively compute the minimum cost up to the top floor (index costSize)
    for (int i = 2; i <= costSize; i++) {
        current = min(prev1 + cost[i - 1], prev2 + cost[i - 2]);
        prev2 = prev1;
        prev1 = current;
    }
    
    return current;
}
