int climbStairs(int n) {
    // Base cases: 1 way for 1 step, 2 ways for 2 steps
    if (n <= 2) {
        return n;
    }
    
    // Variables to track the number of ways for the previous two steps
    int prev2 = 1; // Ways to reach step 1
    int prev1 = 2; // Ways to reach step 2
    int current = 0;
    
    // Iteratively compute ways up to step n
    for (int i = 3; i <= n; i++) {
        current = prev1 + prev2;
        prev2 = prev1;
        prev1 = current;
    }
    
    return current;
}
