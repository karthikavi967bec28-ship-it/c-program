#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// Comparison function for qsort
int compare(const void* a, const void* b) {
    int* p1 = *(int**)a;
    int* p2 = *(int**)b;
    
    // Sort by height descending
    if (p1[0] != p2[0]) {
        return p2[0] - p1[0];
    }
    // If heights are equal, sort by k ascending
    return p1[1] - p2[1];
}

/**
 * Return an array of arrays of size *returnSize.
 * The sizes of the arrays are returned as *returnColumnSizes array.
 * Note: Both returned array and *columnSizes array must be malloced, assume caller calls free().
 */
int** reconstructQueue(int** people, int peopleSize, int* peopleColSize, int* returnSize, int** returnColumnSizes) {
    // 1. Sort the people array based on our criteria
    qsort(people, peopleSize, sizeof(int*), compare);
    
    // 2. Allocate the result array
    int** result = (int**)malloc(peopleSize * sizeof(int*));
    *returnColumnSizes = (int*)malloc(peopleSize * sizeof(int));
    *returnSize = peopleSize;
    
    // 3. Insert each person into the result array at index k
    for (int i = 0; i < peopleSize; i++) {
        int targetIdx = people[i][1];
        
        // Allocate space for the current person in the result
        result[i] = (int*)malloc(2 * sizeof(int));
        (*returnColumnSizes)[i] = 2;
        
        // Shift elements to the right to make room for insertion at targetIdx
        for (int j = i; j > targetIdx; j--) {
            result[j][0] = result[j - 1][0];
            result[j][1] = result[j - 1][1];
        }
        
        // Place the current person at their required position
        result[targetIdx][0] = people[i][0];
        result[targetIdx][1] = people[i][1];
    }
    
    return result;
}
