#include <stdlib.h>

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* plusOne(int* digits, int digitsSize, int* returnSize) {
    // Iterate from the least significant digit (right to left)
    for (int i = digitsSize - 1; i >= 0; i--) {
        // If the current digit is less than 9, just increment it
        if (digits[i] < 9) {
            digits[i]++;
            *returnSize = digitsSize;
            
            // Allocate memory for the result copy as requested
            int* result = (int*)malloc(digitsSize * sizeof(int));
            for (int j = 0; j < digitsSize; j++) {
                result[j] = digits[j];
            }
            return result;
        }
        // If the digit is 9, it rolls over to 0, and the loop continues (carry over)
        digits[i] = 0;
    }
    
    // If the loop finished, it means all digits were 9 (e.g., 99 -> 100)
    *returnSize = digitsSize + 1;
    int* result = (int*)malloc((*returnSize) * sizeof(int));
    
    // The new number will always start with 1 followed by all 0s
    result[0] = 1;
    for (int i = 1; i < *returnSize; i++) {
        result[i] = 0;
    }
    
    return result;
}
