class Solution:
    def isMatch(self, s: str, p: str) -> bool:
        m = len(s)
        n = len(p)
        
        # Initialize a 2D DP matrix with False
        # Dimensions are (m + 1) x (n + 1) to account for empty string cases
        dp = [[False] * (n + 1) for _ in range(m + 1)]
        
        # Base case: Empty string matches empty pattern
        dp[0][0] = True
        
        # Handle patterns that can match an empty string (e.g., "a*", "a*b*")
        for j in range(2, n + 1):
            if p[j - 1] == '*':
                dp[0][j] = dp[0][j - 2]
                
        # Fill out the DP table row by row
        for i in range(1, m + 1):
            for j in range(1, n + 1):
                # If characters match directly or via '.' wildcard
                if p[j - 1] == s[i - 1] or p[j - 1] == '.':
                    dp[i][j] = dp[i - 1][j - 1]
                    
                # If the current pattern character is a '*' wildcard
                elif p[j - 1] == '*':
                    # Case 1: Match 0 times (Look back 2 columns to ignore the preceding char and '*')
                    dp[i][j] = dp[i][j - 2]
                    
                    # Case 2: Match 1 or more times (If preceding pattern character matches string char)
                    if p[j - 2] == s[i - 1] or p[j - 2] == '.':
                        dp[i][j] = dp[i][j] or dp[i - 1][j]
                        
        return dp[m][n]


# Driver code to test the implementation with the examples
if __name__ == "__main__":
    solver = Solution()
    
    # Example 1
    print(f"Example 1: {solver.isMatch('aa', 'a')}")   # Output: False
    
    # Example 2
    print(f"Example 2: {solver.isMatch('aa', 'a*')}")  # Output: True
    
    # Example 3
    print(f"Example 3: {solver.isMatch('ab', '.*')}")  # Output: True
