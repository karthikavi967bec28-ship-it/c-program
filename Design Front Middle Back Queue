#include <stdlib.h>

// Doubly Linked List Node Definition
typedef struct Node {
    int val;
    struct Node* prev;
    struct Node* next;
} Node;

// Deque Structure
typedef struct {
    Node* head;
    Node* tail;
    int size;
} Deque;

// Main Queue Structure containing two deques
typedef struct {
    Deque* left;
    Deque* right;
} FrontMiddleBackQueue;

// Helper: Create a new node
Node* createNode(int val) {
    Node* node = (Node*)malloc(sizeof(Node));
    node->val = val;
    node->prev = NULL;
    node->next = NULL;
    return node;
}

// Helper: Initialize an empty deque
Deque* createDeque() {
    Deque* dq = (Deque*)malloc(sizeof(Deque));
    dq->head = NULL;
    dq->tail = NULL;
    dq->size = 0;
    return dq;
}

// Deque push front
void pushFront(Deque* dq, int val) {
    Node* node = createNode(val);
    if (dq->size == 0) {
        dq->head = dq->tail = node;
    } else {
        node->next = dq->head;
        dq->head->prev = node;
        dq->head = node;
    }
    dq->size++;
}

// Deque push back
void pushBack(Deque* dq, int val) {
    Node* node = createNode(val);
    if (dq->size == 0) {
        dq->head = dq->tail = node;
    } else {
        node->prev = dq->tail;
        dq->tail->next = node;
        dq->tail = node;
    }
    dq->size++;
}

// Deque pop front
int popFront(Deque* dq) {
    if (dq->size == 0) return -1;
    Node* node = dq->head;
    int val = node->val;
    dq->head = dq->head->next;
    if (dq->head) dq->head->prev = NULL;
    else dq->tail = NULL;
    free(node);
    dq->size--;
    return val;
}

// Deque pop back
int popBack(Deque* dq) {
    if (dq->size == 0) return -1;
    Node* node = dq->tail;
    int val = node->val;
    dq->tail = dq->tail->prev;
    if (dq->tail) dq->tail->next = NULL;
    else dq->head = NULL;
    free(node);
    dq->size--;
    return val;
}

// Helper: Rebalance the two deques to maintain sizes
void balance(FrontMiddleBackQueue* obj) {
    if (obj->left->size > obj->right->size) {
        int val = popBack(obj->left);
        pushFront(obj->right, val);
    } else if (obj->right->size > obj->left->size + 1) {
        int val = popFront(obj->right);
        pushBack(obj->left, val);
    }
}

// Initialize FrontMiddleBackQueue
FrontMiddleBackQueue* frontMiddleBackQueueCreate() {
    FrontMiddleBackQueue* obj = (FrontMiddleBackQueue*)malloc(sizeof(FrontMiddleBackQueue));
    obj->left = createDeque();
    obj->right = createDeque();
    return obj;
}

void frontMiddleBackQueuePushFront(FrontMiddleBackQueue* obj, int val) {
    pushFront(obj->left, val);
    balance(obj);
}

void frontMiddleBackQueuePushMiddle(FrontMiddleBackQueue* obj, int val) {
    if (obj->left->size == obj->right->size) {
        pushFront(obj->right, val);
    } else {
        pushBack(obj->left, val);
    }
    balance(obj);
}

void frontMiddleBackQueuePushBack(FrontMiddleBackQueue* obj, int val) {
    pushBack(obj->right, val);
    balance(obj);
}

int frontMiddleBackQueuePopFront(FrontMiddleBackQueue* obj) {
    if (obj->left->size + obj->right->size == 0) return -1;
    int val;
    if (obj->left->size > 0) {
        val = popFront(obj->left);
    } else {
        val = popFront(obj->right);
    }
    balance(obj);
    return val;
}

int frontMiddleBackQueuePopMiddle(FrontMiddleBackQueue* obj) {
    if (obj->left->size + obj->right->size == 0) return -1;
    int val;
    if (obj->left->size == obj->right->size) {
        val = popBack(obj->left);
    } else {
        val = popFront(obj->right);
    }
    balance(obj);
    return val;
}

int frontMiddleBackQueuePopBack(FrontMiddleBackQueue* obj) {
    if (obj->left->size + obj->right->size == 0) return -1;
    int val = popBack(obj->right);
    balance(obj);
    return val;
}

// Free allocated memory
void frontMiddleBackQueueFree(FrontMiddleBackQueue* obj) {
    while (obj->left->size > 0) popFront(obj->left);
    while (obj->right->size > 0) popFront(obj->right);
    free(obj->left);
    free(obj->right);
    free(obj);
}
