int numTrees(int n) {
    // Using long long to prevent any intermediate integer overflow during multiplication
    long long catalan = 1;
    
    for (int i = 0; i < n; i++) {
        // Analytical calculation equivalent to: C_(i+1) = C_i * (2*(2i + 1)) / (i + 2)
        catalan = catalan * 2 * (2 * i + 1) / (i + 2);
    }
    
    return (int)catalan;
}
