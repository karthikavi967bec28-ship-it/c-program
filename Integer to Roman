#include <string>

class Solution {
public:
    std::string intToRoman(int num) {
        // Pairs of integer values and their Roman numeral representations in descending order
        const int values[] = {1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1};
        const std::string symbols[] = {"M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"};
        
        std::string roman_numeral = "";
        
        // Iterate through all available Roman numeral symbols
        for (int i = 0; i < 13; ++i) {
            // Repeatedly append the symbol while the remaining number is greater or equal
            while (num >= values[i]) {
                roman_numeral += symbols[i];
                num -= values[i];
            }
        }
        
        return roman_numeral;
    }
};
